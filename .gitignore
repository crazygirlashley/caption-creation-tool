__pycache__/
*.pyc

# PyInstaller build output — rebuild with: pyinstaller packaging/build.spec
build/
dist/
packaging/icon.ico

# runtime logs (rotated backups: .log.1, .log.2, .log.3)
caption_creator_crash.log*

# DeviantArt auth & settings (private)
da_tokens.json
da_settings.json

# UI theme preference (personal, per-install)
ui_settings.json

# personal watermark images
watermark/

# personal caption formats — only the built-in formats are committed by default
formats/*.json
!formats/Standard.json
!formats/Standard (Vertical).json
!formats/X-Change.json
!formats/X-Change (Vertical).json
!formats/Text Message.json
!formats/Text Message (Vertical).json

# personal UI themes — only the built-in themes are committed by default
# (Basic.json ships too, but as reference only — see themes.py)
themes/*.json
!themes/Dark.json
!themes/Bimbo.json
!themes/Sissy.json
!themes/Basic.json

# Local AI writer settings (server address, model, optional API key)
ai_settings.json

# Recent files / projects / Find Online searches (per-user)
recent.json

# Words added via the spell checker's "Add to dictionary"
user_dictionary.txt

# App background images chosen in Settings -> Background (per-user)
backgrounds/
